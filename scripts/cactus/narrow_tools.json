  {
    "name": "set_voice_settings",
    "description": "Configure text-to-speech voice replies: turn voice off, switch TTS engine (api, assemblyai, local), choose a voice name, or list available voices.",
    "parameters": {
      "type": "object",
      "properties": {
        "mode": {
          "type": "string",
          "enum": [
            "off",
            "api",
            "assemblyai",
            "local"
          ],
          "description": "TTS engine mode"
        },
        "voice": {
          "type": "string",
          "enum": [
            "alloy",
            "echo",
            "fable",
            "onyx",
            "nova",
            "shimmer",
            "coral",
            "sage",
            "ash",
            "ballad",
            "verse"
          ],
          "description": "OpenAI TTS voice name"
        },
        "assembly_voice": {
          "type": "string",
          "enum": [
            "aai-jane",
            "aai-audrey",
            "aai-sara",
            "aai-michael",
            "aai-paul",
            "aai-charles",
            "aai-eve",
            "aai-george"
          ]
        },
        "list": {
          "type": "boolean",
          "description": "true when asking to list available TTS voices"
        }
      },
      "required": []
    }
  },
  {
    "name": "set_timer_reminder",
    "description": "Set a countdown timer reminder that fires after a number of minutes or hours from now.",
    "parameters": {
      "type": "object",
      "properties": {
        "message": {
          "type": "string",
          "description": "what to remind about"
        },
        "minutes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 10080
        },
        "hours": {
          "type": "integer",
          "minimum": 1,
          "maximum": 168
        }
      },
      "required": [
        "message"
      ]
    }
  },
  {
    "name": "schedule_reminder",
    "description": "Schedule a reminder for a calendar date and time.",
    "parameters": {
      "type": "object",
      "properties": {
        "message": {
          "type": "string",
          "description": "what to remind about"
        },
        "due_at": {
          "type": "string",
          "description": "ISO timestamp YYYY-MM-DDTHH:MM:SS"
        },
        "repeat": {
          "type": "string",
          "enum": [
            "weekly",
            "monthly"
          ]
        }
      },
      "required": [
        "message",
        "due_at"
      ]
    }
  },
  {
    "name": "reminder_list",
    "description": "List scheduled pending and past reminders.",
    "parameters": {
      "type": "object",
      "properties": {},
      "required": []
    }
  },
  {
    "name": "reminder_cancel",
    "description": "Cancel and delete a scheduled reminder by its id.",
    "parameters": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^rmd_[a-zA-Z0-9]+$",
          "description": "reminder id starting with rmd_"
        }
      },
      "required": [
        "id"
      ]
    }
  },
