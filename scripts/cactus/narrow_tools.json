    }
  },
  {
    "name": "set_ui_theme",
    "description": "Change KAI app color palette theme (Tokyo Night, Nord, Catppuccin, Dracula, Rose Pine, Emerald, Amber, Kanagawa, Gruvbox, Solarized, One Dark, or default).",
    "parameters": {
      "type": "object",
      "properties": {
        "palette": {
          "type": "string",
          "enum": [
            "default",
            "tokyo-night",
            "nord",
            "catppuccin",
            "dracula",
            "rose-pine",
            "emerald",
            "amber",
            "kanagawa",
            "gruvbox",
            "solarized",
            "one-dark"
